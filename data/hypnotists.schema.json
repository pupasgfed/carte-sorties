{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypnose près de chez toi — Hypnotist",
  "type": "object",
  "required": ["id", "name", "city", "department", "rating", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "city": { "type": "string", "minLength": 1, "maxLength": 120 },
    "department": { "type": "string", "pattern": "^[0-9]{2,3}$" },
    "description": { "type": ["string", "null"], "maxLength": 10000 },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "website": { "type": ["string", "null"], "format": "uri" },
    "instagram": { "type": ["string", "null"], "maxLength": 100 },
    "twitter": { "type": ["string", "null"], "maxLength": 100 },
    "phone": { "type": ["string", "null"], "maxLength": 40 },
    "email": { "type": ["string", "null"], "format": "email" },
    "image": { "type": ["string", "null"], "format": "uri" },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "status": { "type": "string", "enum": ["published", "draft"] }
  },
  "additionalProperties": false
}
